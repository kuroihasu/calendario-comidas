DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comidas"
# Firma de la sesión de administradores
JWT_SECRET="cambia-esto-por-un-secreto-largo"
# Admin inicial que crea la semilla
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia-esta-clave"
# URL de la API vista desde el servidor SSR de Angular
API_URL="http://localhost:3000"
# URL pública de la web (enlaces en los .ics)
PUBLIC_URL="http://localhost:4200"
# Dominios permitidos para el SSR, separados por coma
ALLOWED_HOSTS="localhost"
