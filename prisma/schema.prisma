// Fase 1: días de comida, sus fechas por año y administradores.
// Ofertas, dispositivos y campañas se agregan en las fases 2 a 4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DateRuleType {
  fixed
  nth_weekday
}

enum FoodCategory {
  sandwich
  plato
  dulce
  bebida
  otro
}

enum AdminRole {
  admin
  editor
}

model FoodDay {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique
  name         String
  /// Nombre corto para titulares: "Completo" en "Día del Completo".
  shortName    String       @map("short_name")
  tagline      String
  description  String
  imageUrl     String?      @map("image_url")
  category     FoodCategory
  /// Ingredientes en orden, de arriba hacia abajo; dibujan la ilustración del día.
  layers       Json         @default("[]")
  dateRuleType DateRuleType @map("date_rule_type")
  month        Int
  day          Int?
  /// 1 = lunes … 7 = domingo (ISO).
  weekday      Int?
  /// 1 a 4, o -1 para "el último".
  weekOfMonth  Int?         @map("week_of_month")
  isActive     Boolean      @default(true) @map("is_active")
  sourceNote   String?      @map("source_note")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  occurrences FoodDayOccurrence[]

  @@map("food_day")
}

model FoodDayOccurrence {
  id          String   @id @default(uuid()) @db.Uuid
  foodDayId   String   @map("food_day_id") @db.Uuid
  year        Int
  date        DateTime @db.Date
  isConfirmed Boolean  @default(false) @map("is_confirmed")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  foodDay FoodDay @relation(fields: [foodDayId], references: [id], onDelete: Cascade)

  @@unique([foodDayId, year])
  @@index([date])
  @@map("food_day_occurrence")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(editor)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  auditLogs AuditLog[]

  @@map("admin_user")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@map("audit_log")
}
